# Optional: leave empty to use the instant offline quiz fallback.
# WARNING: VITE_ variables are bundled into browser code and are visible to users.
VITE_API_URL=https://cariervirtual.onrender.com
VITE_DEEPSEEK_API_KEY=

# Server-only configuration. Never prefix these with VITE_.
MONGODB_URI=mongodb://127.0.0.1:27017/mening-virtual-karyeram
SESSION_SECRET=
API_PORT=3001

# On first server start, this account is created with the admin role.
# Use a unique password with at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
